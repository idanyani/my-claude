{
  "permissions": {
    "allow": [
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(python3 /home/idanyani/.claude/skills/resolve-issue/scripts/view_issue.py *)",
      "Bash(python3 /home/idanyani/.claude/skills/resolve-issue/scripts/start_branch.py *)",
      "Bash(python3 /home/idanyani/.claude/skills/resolve-issue/scripts/wait_for_copilot_review.py *)",
      "Bash(python3 /home/idanyani/.claude/skills/resolve-issue/scripts/request_copilot_review.py *)",
      "Bash(python3 /home/idanyani/.claude/skills/resolve-issue/scripts/finish_branch.py *)",
      "Bash(python3 /home/idanyani/.claude/skills/maintain/scripts/changed_files.py *)",
      "Bash(python3 /home/idanyani/.claude/skills/maintain/scripts/check_links.py *)",
      "Bash(aws logs describe-log-streams *)",
      "Bash(aws logs get-query-results *)",
      "Bash(aws logs get-log-events *)",
      "Bash(aws logs filter-log-events *)",
      "Bash(aws ssm get-command-invocation *)",
      "Bash(aws sts get-caller-identity)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws ec2 describe-instances *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/check_prose.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/check_pgrep_pattern.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/report_stale_shells.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
