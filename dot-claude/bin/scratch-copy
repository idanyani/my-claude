#!/usr/bin/env bash
# Copy the files git lists in the repo holding the current directory -- tracked and untracked but
# not ignored, as they stand in the working tree -- into a new temporary directory, and print its
# path. --ignore-failed-read skips a tracked file deleted from the working tree.
set -euo pipefail

top="$(git rev-parse --show-toplevel)"
copy="$(mktemp -d)"
git -C "$top" ls-files -z -co --exclude-standard |
    tar -C "$top" --null --no-recursion --ignore-failed-read -T - -cf - | tar -C "$copy" -xf -
echo "$copy"
