#! /bin/bash
# Git hook that install.sh links as post-merge, post-checkout, and post-rewrite: reinstall
# whenever a pull, checkout, or rebase changes the clone, so the live settings never register a
# hook file the change removed. Git shares hooks across worktrees, but ~/.claude links into the
# main checkout only, so a change in any other worktree has nothing to reinstall.
set -euo pipefail

[ "$(git rev-parse --absolute-git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] || exit 0
# The git command already succeeded; a failed install must not make it report failure.
"$(git rev-parse --show-toplevel)/install.sh" || echo "reinstall failed: run ./install.sh" >&2
